# ============================================================
# G1 SCAN UDP BRIDGE LAUNCH
# ============================================================
#
# This launch starts the robot-side LiDAR preprocessing pipeline
# and the UDP bridge processes.
#
# The raw Livox PointCloud2 topic is visible only inside the
# Unitree DDS / eth0 environment. Sending this full cloud over
# Wi-Fi is too heavy, so the cloud is converted locally on the
# robot into a lightweight LaserScan.
#
# Architecture:
#
#   /utlidar/cloud_livox_mid360
#          ↓
#   pc2_restamper_node
#          ↓
#   cloud_y_flip_node
#          ↓
#   pointcloud_to_laserscan_node
#          ↓
#        /scan_robot
#          ↓
#   topics_udp_sender_node
#          ↓ UDP
#   topics_udp_receiver_node
#          ↓
#      /repub/scan
#
# ETH0_ENV nodes:
#   - pc2_restamper_node
#   - cloud_y_flip_node
#   - pointcloud_to_laserscan_node
#   - topics_udp_sender_node
#
# WIFI_ENV nodes:
#   - topics_udp_receiver_node
#   - ros2_nav_bridge_node
#
# Result:
#   The external PC receives /repub/scan without receiving the
#   heavy /utlidar/cloud_livox_mid360 PointCloud2 stream.
# ============================================================
def generate_launch_description():
    bridge_odom = LaunchConfiguration("bridge_odom")
    bridge_dog_odom = LaunchConfiguration("bridge_dog_odom")
    bridge_mola_odom = LaunchConfiguration("bridge_mola_odom")
    bridge_imu = LaunchConfiguration("bridge_imu")
