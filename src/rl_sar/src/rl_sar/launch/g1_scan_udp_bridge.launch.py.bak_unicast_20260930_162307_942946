    bridge_global_costmap = LaunchConfiguration("bridge_global_costmap")
    bridge_local_costmap = LaunchConfiguration("bridge_local_costmap")
    
    g1_nav2_share = get_package_share_directory("g1_nav2")

    # -------------------------
    # G1 real robot low-level launch args
    # -------------------------
    network_interface = LaunchConfiguration("network_interface")
    cmd_vel_topic = LaunchConfiguration("cmd_vel_topic")
    cmd_vel_timeout_sec = LaunchConfiguration("cmd_vel_timeout_sec")
    hw_mode = LaunchConfiguration("hw_mode")
    g1_mode = LaunchConfiguration("g1_mode")
    joint_states_topic = LaunchConfiguration("joint_states_topic")
    tf_time_offset_sec = LaunchConfiguration("tf_time_offset_sec")
    yaw_correction_rad_value = LaunchConfiguration("yaw_correction_rad")
    odom_source = LaunchConfiguration("odom_source")
    enable_dog_odom_calibration = LaunchConfiguration(
        "enable_dog_odom_calibration"
    )
    lidar_source = LaunchConfiguration("lidar_source")
    enable_realsense = LaunchConfiguration(
        "enable_realsense"
    )
    enable_realsense_tf = LaunchConfiguration(
        "enable_realsense_tf"
    )

    is_unitree_lidar = IfCondition(
        PythonExpression([
            "'", lidar_source, "' == 'unitree'"
        ])
    )

    is_livox_lidar = IfCondition(
        PythonExpression([
            "'", lidar_source, "' == 'livox'"
        ])
    )

    lidar_topic = PythonExpression([
        "'/utlidar/cloud_livox_mid360' "
        "if '", lidar_source, "' == 'unitree' "
        "else '/livox/lidar'"
    ])

    imu_input_topic = LaunchConfiguration(
    "imu_input_topic"
    )

    imu_input_frame = LaunchConfiguration(
        "imu_input_frame"
    )

    imu_adapter_output_topic = LaunchConfiguration(
        "imu_adapter_output_topic"
    )

    imu_topics = {
        "livox": "/imu_livox_corrected",
    }

    use_cloud_stabilizer = LaunchConfiguration("use_cloud_stabilizer")
    


    # ------------------------------------------------------------
    # 3) OFFICIAL POINTCLOUD2 -> LASERSCAN CONVERSION
    # ------------------------------------------------------------
    # This node is not compiled inside rl_sar.
    # It comes from the official ROS 2 package:
    #
    #   pointcloud_to_laserscan
    #
    # It subscribes to the corrected cloud:
    #
    #   /cloud_fixed
    #
    # and publishes the lightweight 2D scan:
    #
    #   /scan_robot
    #
    # /scan_robot is then transported by topics_udp_sender_node
    # instead of sending the full PointCloud2 over Wi-Fi. 
    cloud_nav_stabilizer = Node(
        package="rl_sar",
        executable="cloud_nav_stabilizer_node",
        name="cloud_nav_stabilizer_node",
        output="screen",
        additional_env=ETH0_ENV,

        parameters=[{
            "input_cloud_topic": lidar_topic,
            "output_cloud_topic": "/cloud_nav_deskewed",

            "source_frame": "livox_frame",
            "target_frame": "base_footprint",

            # Automatically select point-level deskew or cloud-level transform.
            "point_time_mode": "auto",
            "point_time_field": "time",
            "point_time_unit": "nanoseconds",
            "time_scale": 1.0e-9,

            "deskew_bins": 40,

            # Same exact value used by mola_odom_adapter_node.
            "common_time_offset_sec": common_time_offset_sec,
            "time_origin_mode": "auto_offset",
            "offset_filter_alpha": 0.02,
            "cloud_time_offset_sec": 0.0,
            "tf_time_offset_sec": tf_time_offset_sec,

            "output_stamp_policy": "current_ros_time",
        }],
    )

    cloud_stamp_relay = Node(
        package="rl_sar",
        executable="cloud_stamp_relay_node",
        name="cloud_stamp_relay_node",
        output="screen",
        additional_env=ETH0_ENV,

        parameters=[{
            "input_topic": "/utlidar/cloud_livox_mid360",
            "output_topic": "/cloud_livox_now",
            "log_every_n": 100,
        }],
    )

    cloud_to_scan_in = Node(
        package="pointcloud_to_laserscan",
        executable="pointcloud_to_laserscan_node",
        name="pointcloud_to_laserscan_node",
        output="screen",
        additional_env=ETH0_ENV,

        condition=is_unitree_lidar,

        remappings=[
            ("cloud_in", "/cloud_nav_deskewed"),
            ("scan", "/scan"),
        ],

        parameters=[{
            # ----------------------------------------------------------
            # Reference frame used to project the PointCloud2 into 2D.
            #
            # IMPORTANT:
            # In the current G1 URDF:
            #
            #     base_footprint == pelvis
            #
            # because:
            #
            #     base_footprint -> pelvis
            #     xyz = [0, 0, 0]
            #
            # Therefore z=0 in base_footprint is NOT the floor.
            # It corresponds approximately to the pelvis height.
            #
            # Estimated pelvis height above floor:
            #
            #     H_pelvis ~= 0.78 m
            #
            # Consequently, a physical height H above the floor must be
            # converted into base_footprint coordinates using:
            #
            #     z_base = H_floor - H_pelvis
            #
            # ----------------------------------------------------------
            "target_frame": "base_footprint",

            "transform_tolerance": 0.05,

            # ----------------------------------------------------------
            # Vertical PointCloud slice used to generate /scan
            # ----------------------------------------------------------
            #
            # Approximate pelvis height above floor:
            #     H_pelvis ~= 0.78 m
            #
            # Desired minimum physical obstacle height:
            #     H_min = 0.25 m
            #
            # Conversion:
            #     z_min = H_min - H_pelvis
            #           = 0.25 - 0.78
            #           = -0.53 m
            #
            # This higher minimum threshold is intentionally used to reject
            # floor/self returns that can enter the scan during humanoid
            # body oscillations and rotations.
            "min_height": -0.53,

            # Desired maximum physical height:
            #     H_max = 1.50 m
            #
            #     z_max = 1.50 - 0.78
            #           = +0.72 m
            "max_height": 0.72,

            # Full 360-degree scan.
            "angle_min": -3.141592653589793,
            "angle_max": 3.141592653589793,

            # Approximately 0.5 degree angular resolution.
            "angle_increment": 0.0087,

            "scan_time": 0.10,

            # Ignore points closer than 30 cm to reduce robot/self returns
            # and retain measurements up to 30 m.
            "range_min": 0.30,
            "range_max": 30.0,

            "use_inf": True,
            "inf_epsilon": 1.0,

            "queue_size": 5,
        }],
    )

    cloud_to_scan = Node(
        package="pointcloud_to_laserscan",
        executable="pointcloud_to_laserscan_node",
        name="pointcloud_to_laserscan",
        output="screen",

        env=ETH0_ENV,

        condition=is_livox_lidar,

        remappings=[
            ("cloud_in", lidar_topic),
            ("scan", "/scan"),
        ],

        parameters=[{
            # ----------------------------------------------------------
            # The current base_footprint origin is coincident with pelvis.
            #
            # Approximate physical pelvis height:
            #
            #     H_pelvis ~= 0.78 m
            #
            # Therefore:
            #
            #     z_base = H_floor - 0.78
            #
            # and NOT simply:
            #
            #     z_base = H_floor
            #
            # ----------------------------------------------------------
            "target_frame": "base_footprint",

            "transform_tolerance": 0.05,

            # Approximate pelvis height above floor:
            #     H_pelvis ~= 0.78 m
            #
            # Desired minimum physical obstacle height:
            #     H_min = 0.25 m
            #
            # Conversion:
            #     z_min = H_min - H_pelvis
            #           = 0.25 - 0.78
            #           = -0.53 m
            #
            # This higher minimum threshold is intentionally used to reject
            # floor/self returns that can enter the scan during humanoid
            # body oscillations and rotations.
            "min_height": -0.53,

            # Desired maximum physical height:
            #     H_max = 1.50 m
            #
            #     z_max = 1.50 - 0.78
            #           = +0.72 m
            "max_height": 0.72,

            "angle_min": -3.14159,
            "angle_max": 3.14159,
            "angle_increment": 0.0087,

            "scan_time": 0.1,

            "range_min": 0.3,
            "range_max": 30.0,

            "use_inf": True,
        }],
    )

