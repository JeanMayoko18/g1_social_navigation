                export IMU_POSE_X=0.08 && \
                export IMU_POSE_Y=0.0 && \
                export IMU_POSE_Z=1.20 && \
                export IMU_POSE_YAW=0.0 && \
                export IMU_POSE_PITCH=0.0 && \
                export IMU_POSE_ROLL=0.0 && \

                export MOLA_LOCALIZATION_PUBLISH_TF=false && \
                export MOLA_TF_FOOTPRINT_LINK="" && \

                mola-cli $HOME/g1_ws/mola_g1_ros2.yaml
                """
            ],
            output="screen",
        )

        return [mola_process]

    mola_lidar_odom_launch = ExecuteProcess(
        cmd=[
            "bash",
            "-lc",
            """
            source /opt/ros/foxy/setup.bash && \
            export CMAKE_PREFIX_PATH="$HOME/cli11_install:$HOME/mrpt_install:$CMAKE_PREFIX_PATH" && \
            export LD_LIBRARY_PATH="$HOME/mrpt_install/lib:$HOME/g1_ws/install/mola_kernel/lib:$HOME/g1_ws/install/mp2p_icp_core/lib:$HOME/g1_ws/install/mola_pose_list/lib:$HOME/g1_ws/install/mola_imu_preintegration/lib:$HOME/g1_ws/install/mola_bridge_ros2/lib:$HOME/g1_ws/install/mola_state_estimation_simple/lib:$LD_LIBRARY_PATH" && \
            source $HOME/g1_ws/install/setup.bash && \

            export ROS_DOMAIN_ID=0 && \
            export ROS_LOCALHOST_ONLY=0 && \
            export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp && \
            export CYCLONEDDS_URI=/home/unitree/cyclonedds_ws/cyclonedds.xml && \

            export MOLA_LIDAR_TOPIC=/utlidar/cloud_livox_mid360 && \
            export MOLA_IMU_TOPIC=/utlidar/imu_livox_mid360 && \

            export MOLA_USE_FIXED_LIDAR_POSE=true && \
            export MOLA_USE_FIXED_IMU_POSE=true && \

            export LIDAR_POSE_X=0.08 && \
            export LIDAR_POSE_Y=0.0 && \
            export LIDAR_POSE_Z=1.20 && \
