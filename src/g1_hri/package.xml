<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_hri</name>
  <version>0.0.0</version>
  <description>
    Human-Robot Interaction management and ROS4HRI integration for the Unitree G1.
  </description>
  <maintainer email="icmayoko18@gmail.com">jean</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>g1_social_msgs</depend>
    <!--
    ROS4HRI dialogue runtime dependency.
    This package is used only when interaction=dialogue on ROS 2 Humble.
  -->
  <exec_depend>dialogue_manager</exec_depend>
  <depend>tts_msgs</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
